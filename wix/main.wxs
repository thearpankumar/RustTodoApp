<?xml version='1.0' encoding='utf-8'?>

<!--
  WiX source for the Windows installer, built by `cargo wix`.

  This file is committed on purpose: `cargo wix init` regenerates it from a
  stock template that has no Start Menu shortcut at all, which is why earlier
  releases installed an executable Windows never surfaced in Start or Search.
  Do NOT run `cargo wix init` again - it will overwrite everything below.

  Variables supplied by cargo-wix at build time:
    Version           the package version
    CargoTargetBinDir the directory holding the built executables
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Todo App'
        UpgradeCode='5DA88BFA-EABB-4173-A9BC-AEE3DFBC4B72'
        Manufacturer='thearpankumar'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Todo App - projects, tasks and a notes canvas'
            Manufacturer='thearpankumar'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <!-- Upgrade in place instead of installing side by side. -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Todo App Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Todo App'>

                    <!-- Makes `Win+R -> todo_app` and ShellExecute find the app. -->
                    <Component Id='AppPaths' Guid='8F333AD7-B7A7-476C-A809-EEFB6FEA5FEC'>
                        <RegistryKey Root='HKLM'
                            Key='SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\todo_app.exe'>
                            <RegistryValue Type='string' Value='[#exe0]' KeyPath='yes'/>
                            <RegistryValue Name='Path' Type='string' Value='[Bin]'/>
                        </RegistryKey>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='B96CD982-4770-4DB2-ADAD-737D5B6185DF' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>

                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='todo_app.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\todo_app.exe'
                                KeyPath='yes'>
                                <!-- This is what puts the app in the Start menu and
                                     in Windows Search. Nesting it in the File element
                                     means MSI handles its lifetime for us. -->
                                <Shortcut Id='StartMenuShortcut'
                                    Directory='ProgramMenuFolder'
                                    Name='Todo App'
                                    Description='Projects, tasks and a notes canvas, one keystroke away'
                                    WorkingDirectory='Bin'
                                    Icon='ProductICO'
                                    Advertise='yes'/>
                            </File>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'/>

            <Directory Id='DesktopFolder' Name='Desktop'>
                <Component Id='DesktopShortcut' Guid='53AB11E9-F8C2-496F-84A3-D396AC602463'>
                    <Shortcut Id='ApplicationDesktopShortcut'
                        Name='Todo App'
                        Description='Projects, tasks and a notes canvas, one keystroke away'
                        Target='[#exe0]'
                        WorkingDirectory='Bin'
                        Icon='ProductICO'/>
                    <RegistryValue Root='HKLM'
                        Key='SOFTWARE\thearpankumar\Todo App'
                        Name='DesktopShortcut'
                        Type='integer'
                        Value='1'
                        KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the application and its Start menu entry.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='AppPaths'/>

            <Feature
                Id='DesktopShortcutFeature'
                Title='Desktop Shortcut'
                Description='Add a shortcut for [ProductName] to the desktop.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='DesktopShortcut'/>
            </Feature>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- Icon for the Start menu entry and the Add/Remove Programs listing. -->
        <Icon Id='ProductICO' SourceFile='assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/thearpankumar/RustTodoApp'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/thearpankumar/RustTodoApp'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
